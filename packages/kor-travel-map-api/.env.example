# =============================================================================
# kor-travel-map-api backend .env.example
#
# ApiSettings는 `KOR_TRAVEL_MAP_API_*` prefix를 사용한다. provider credential은
# Dagster/provider runtime만 소유하며 REST API backend에는 주입하지 않는다.
# Docker compose 사용 시 이 파일을 같은 디렉토리의 `.env`로 복사한다. root `.env`는
# Dagster/provider runtime용이며 API container의 `env_file`로 사용하지 않는다.
# =============================================================================

# -- 실행 profile -------------------------------------------------------------
# production은 fail-closed (ADR-066 T-VN-01): admin proxy secret(앞뒤 공백 없는
# 32자 이상) 누락, ops surface 활성 상태의 read/cancel token 누락, features
# surface의 PUBLIC_API_KEY_REQUIRED=false 또는 SERVICE_TOKEN 누락, 인증 없는
# /debug 라우터 활성이면 기동을 거부한다. secret 미설정 local-dev fallback은
# local-dev profile에서만 동작한다.
# Docker image/compose는 기본 production을 주입한다 — 이 값은 비-Docker 로컬용.
KOR_TRAVEL_MAP_API_PROFILE=local-dev

# -- 서버 바인드 --------------------------------------------------------------
# uvicorn host/port. 0.0.0.0 직접 바인드 금지 — Cloudflare Tunnel/SSO 뒤.
KOR_TRAVEL_MAP_API_HOST=127.0.0.1
KOR_TRAVEL_MAP_API_PORT=12701
KOR_TRAVEL_MAP_API_DAGSTER_URL=http://127.0.0.1:12702
KOR_TRAVEL_MAP_API_DAGSTER_ALLOWED_HOSTS=["127.0.0.1","localhost","::1","dagster"]
KOR_TRAVEL_MAP_API_DAGSTER_REPOSITORY_NAME=__repository__
KOR_TRAVEL_MAP_API_DAGSTER_REPOSITORY_LOCATION_NAME=kortravelmap.dagster.definitions
KOR_TRAVEL_MAP_API_BACKUP_ROOT=data/backups
KOR_TRAVEL_MAP_API_BACKUP_PROJECT_ROOT=.
KOR_TRAVEL_MAP_API_BACKUP_SCRIPT_PATH=scripts/docker-backup.sh
KOR_TRAVEL_MAP_API_RESTORE_SCRIPT_PATH=scripts/docker-restore.sh
KOR_TRAVEL_MAP_API_BACKUP_COMMAND_ENABLED=false
KOR_TRAVEL_MAP_API_BACKUP_COMMAND_TIMEOUT_SECONDS=1800
KOR_TRAVEL_MAP_API_RESTORE_APP_DB=kor_travel_map_restore
KOR_TRAVEL_MAP_API_RESTORE_DAGSTER_DB=kor_travel_map_dagster_restore
KOR_TRAVEL_MAP_API_RESTORE_RUSTFS_VOLUME=kor-travel-map-rustfs-restore
KOR_TRAVEL_MAP_API_LOG_LEVEL=info
KOR_TRAVEL_MAP_API_CORS_ALLOW_ORIGINS=["http://localhost:12705","http://127.0.0.1:12705"]
# BFF 공유 secret의 단일 정본은 root .env의 KOR_TRAVEL_MAP_ADMIN_PROXY_SECRET이다.
# API도 같은 이름을 직접 읽으므로 이 package env에는 중복 선언하지 않는다.
# PinVi server principal은 API process에만 주입한다. 로컬은 required=false에서 두
# token을 모두 빈 값으로 두어 비활성화할 수 있다. n150 production은 required=true와
# 두 실제 token을 함께 주입한다. 활성 token은 모든 공백을 금지한 32자 이상이며,
# 서로 다르고 admin BFF/service token과도 달라야 한다. 감사 actor는 코드 상수
# service:pinvi로 고정되어 별도 env가 없다.
KOR_TRAVEL_MAP_API_OPS_PRINCIPAL_REQUIRED=false
KOR_TRAVEL_MAP_API_OPS_READ_TOKEN=
KOR_TRAVEL_MAP_API_OPS_CANCEL_TOKEN=
# 외부 service surface(/v1/features/batch 등) 게이트용 token (ADR-045 D-1,
# ADR-066 T-VN-01). local-dev는 비워 두면 강제하지 않는다. production은 features
# surface 활성 시 앞뒤 공백 없는 32자 이상 값을 필수화하며, Docker compose는
# host env KOR_TRAVEL_MAP_API_SERVICE_TOKEN을 hard-require로 전달한다. admin
# BFF secret·ops read/cancel token과 서로 다른 값이어야 한다(entrypoint 거부).
KOR_TRAVEL_MAP_API_SERVICE_TOKEN=
# `/v1/features/search` stateless cursor HMAC-SHA256 전용 secret. production의
# features surface에서는 공백 없는 32자 이상 값이 필수이고 다른 인증/scrape
# secret과 공유할 수 없다. local-dev에서만 빈 값이면 process-local 난수 key를
# 쓰므로 재시작 또는 여러 worker 사이에는 기존 cursor가 무효화된다.
KOR_TRAVEL_MAP_API_CURSOR_SIGNING_SECRET=
KOR_TRAVEL_MAP_API_ADMIN_TRUSTED_PROXY_CIDRS=["127.0.0.1/32","::1/128"]
KOR_TRAVEL_MAP_API_PUBLIC_API_KEY_REQUIRED=true
KOR_TRAVEL_MAP_API_PUBLIC_API_KEY_CACHE_TTL_S=30
KOR_TRAVEL_MAP_API_VWORLD_API_KEY=CHANGE_ME

# Prometheus pull scrape endpoint. kor-travel-docker-manager 관측 스택은
# Grafana 12205 / cAdvisor 12301 / Prometheus 12401을 사용하고, API 포트
# 12701의 이 path를 scrape한다. REST HTTP와 DB query 성능 메트릭을 함께 제공한다.
KOR_TRAVEL_MAP_API_PROMETHEUS_METRICS_ENABLED=true
KOR_TRAVEL_MAP_API_PROMETHEUS_METRICS_PATH=/metrics
# /metrics scrape identity 경계 (ADR-066 결정 4, T-VN-02). 설정하면 scrape는
# 같은 값의 Authorization Bearer 헤더가 필요하다. local-dev는 비워 두면 기존
# open scrape를 유지하고, production은 metrics endpoint 활성 시 앞뒤 공백 없는
# 32자 이상 값을 필수화한다(admin secret·service/ops token과 달라야 함).
# Docker compose는 host env KOR_TRAVEL_MAP_API_METRICS_TOKEN을 hard-require로
# 전달하며, Prometheus scrape_config authorization(type Bearer)에 같은 값을 둔다.
KOR_TRAVEL_MAP_API_METRICS_TOKEN=

# -- 메인 라이브러리 공유 설정 ----------------------------------------------
# offline upload validation / feature update scope 보강에서 쓰는 kor-travel-geo REST.
KOR_TRAVEL_MAP_KOR_TRAVEL_GEO_BASE_URL=http://127.0.0.1:12501
KOR_TRAVEL_MAP_KOR_TRAVEL_GEO_TIMEOUT_SECONDS=10.0
# 현재는 VWorld API key와 동일한 값을 사용한다.
KOR_TRAVEL_MAP_KOR_TRAVEL_GEO_API_KEY=CHANGE_ME

# Admin curated feature 주소/POI 검색. concierge feature export와 무관하게
# FastAPI backend가 각 provider API를 직접 호출한다.
KOR_TRAVEL_MAP_KAKAO_LOCAL_REST_API_KEY=
KOR_TRAVEL_MAP_NAVER_SEARCH_CLIENT_ID=
KOR_TRAVEL_MAP_NAVER_SEARCH_CLIENT_SECRET=
KOR_TRAVEL_MAP_GOOGLE_PLACES_API_KEY=

# -- 라우터 활성화 ------------------------------------------------------------
# /debug/* 라우터 — MOIS raw는 local-dev mount에서도 admin BFF 인증을 요구한다.
# production profile은 방어 심층화로 route mount 자체를 금지하며 Docker compose는
# 컨테이너 기본 false를 주입한다(ADR-066/T-VN-03).
KOR_TRAVEL_MAP_API_DEBUG_ROUTES_ENABLED=true
KOR_TRAVEL_MAP_API_FEATURES_ROUTES_ENABLED=true
KOR_TRAVEL_MAP_API_ADMIN_ROUTES_ENABLED=true
KOR_TRAVEL_MAP_API_OPS_ROUTES_ENABLED=true
# 파괴적 admin 작업(restore/swap·feature deactivate·POI/backup/offline delete·file
# purge) kill-switch. T-VN-H02로 코드 기본값이 False(fail-closed)로 바뀌었다 —
# 파괴적 작업이 필요하면 아래처럼 명시 true(Docker compose는 컨테이너 기본 true 주입).
KOR_TRAVEL_MAP_API_DESTRUCTIVE_ENABLED=true
