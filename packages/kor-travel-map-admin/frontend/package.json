{
  "name": "kor-travel-map-admin-frontend",
  "version": "0.2.0-dev",
  "description": "Debug UI frontend for kor-travel-map (Next.js + MapLibre GL + VWorld style builder).",
  "private": true,
  "scripts": {
    "predev": "node ./scripts/copy-maplibre-worker.mjs",
    "dev": "next dev --port 12705 --hostname 127.0.0.1",
    "prebuild": "node ./scripts/copy-maplibre-worker.mjs",
    "build": "next build",
    "start": "next start --port 12705 --hostname 127.0.0.1",
    "lint": "eslint . --max-warnings 0",
    "type-check": "tsc --noEmit && tsc -p e2e/tsconfig.json --noEmit && tsc -p tsconfig.tooling.json --noEmit",
    "type-check:e2e": "tsc -p e2e/tsconfig.json --noEmit",
    "doctor": "react-doctor --scope full --no-score --no-telemetry --no-respect-inline-disables --blocking warning .",
    "gen:types": "openapi-typescript ../../kor-travel-map-api/openapi.json -o src/api/types.ts",
    "gen:types:check": "openapi-typescript ../../kor-travel-map-api/openapi.json -o src/api/types.ts --check",
    "test": "vitest run --exclude \"e2e/**\" --passWithNoTests",
    "e2e": "playwright test",
    "e2e:mocked": "playwright test",
    "e2e:mocked:checkpoint": "node e2e/run-mocked-checkpoint.mjs",
    "e2e:live": "playwright test --config playwright.live.config.ts",
    "e2e:live:cache-target-streams": "playwright test --config playwright.cache-target-streams.live.config.ts",
    "e2e:list": "playwright test --list --reporter=dot && playwright test --config playwright.live.config.ts --list --reporter=./e2e/reporter-load-check.ts && playwright test --config playwright.cache-target-streams.live.config.ts --list --reporter=dot",
    "e2e:ui": "playwright test --ui",
    "e2e:install": "playwright install chromium",
    "e2e:report": "playwright show-report"
  },
  "dependencies": {
    "@base-ui/react": "1.9.0",
    "@kor-travel-map/map-marker-react": "*",
    "@tanstack/react-query": "5.104.5",
    "@tanstack/react-table": "8.21.3",
    "@tanstack/react-virtual": "3.14.22",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "lucide-react": "1.61.0",
    "maplibre-gl": "6.15.0",
    "next": "16.4.3",
    "pretendard": "1.3.9",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "sonner": "2.0.8",
    "tailwind-merge": "3.7.0",
    "tw-animate-css": "1.4.0",
    "zustand": "5.0.16",
    "@kor-travel/ui": "file:vendor/kor-travel-ui-0.1.0-dev.6.tgz",
    "@kor-travel/tokens": "file:vendor/kor-travel-tokens-0.1.0.tgz"
  },
  "devDependencies": {
    "@next/eslint-plugin-next": "16.4.3",
    "@playwright/test": "1.64.1",
    "@tailwindcss/postcss": "4.3.3",
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "eslint": "10.13.0",
    "eslint-import-resolver-typescript": "4.4.5",
    "eslint-plugin-import-x": "4.17.1",
    "eslint-plugin-jsx-a11y-x": "0.2.0",
    "eslint-plugin-react-dom": "5.28.8",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-x": "5.28.8",
    "jsdom": "30.1.3",
    "openapi-typescript": "7.13.0",
    "react-doctor": "0.9.1",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.0",
    "vite-tsconfig-paths": "6.1.1",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  },
  "engines": {
    "node": "^22.22.2 || ^24.15.0 || >=26.0.0",
    "npm": "12.0.1"
  }
}
